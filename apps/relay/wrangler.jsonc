{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "coc-room-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "workers_dev": true,
  "preview_urls": false,
  // Serve the built web app from the same worker: one URL for testers, and
  // page-to-relay calls become same-origin. /v1/* always reaches the worker.
  "assets": {
    "directory": "../desktop/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1/*"]
  },
  "observability": {
    "enabled": false
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RelayRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RelayRoom"]
    }
  ]
}
