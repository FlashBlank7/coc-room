{
  "name": "coc-room",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first CoC 7e peer-to-peer tabletop room",
  "license": "MIT",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "test": "pnpm -r test",
    "dev": "pnpm dev:web",
    "dev:web": "pnpm --filter @coc-room/protocol build && pnpm --parallel --stream --filter @coc-room/protocol --filter @coc-room/desktop --filter @coc-room/relay dev:web",
    "dev:web:ui": "pnpm --filter @coc-room/protocol build && pnpm --parallel --stream --filter @coc-room/protocol --filter @coc-room/desktop dev:web",
    "dev:web:duo": "node scripts/dev-web-duo.mjs",
    "dev:desktop": "pnpm dev:web:ui",
    "dev:relay": "pnpm --filter @coc-room/relay dev",
    "smoke:web": "pnpm --filter @coc-room/protocol build && pnpm --filter @coc-room/desktop smoke:web",
    "smoke:web-bridge": "pnpm --filter @coc-room/desktop smoke:web-bridge",
    "smoke:web-duo": "node scripts/dev-web-duo.mjs --smoke --no-open",
    "test:web-duo": "node --test scripts/dev-web-duo.test.mjs",
    "prepare:windows": "powershell -ExecutionPolicy Bypass -File scripts/prepare-windows.ps1",
    "smoke:sidecar": "node services/module-parser/scripts/smoke-frozen.mjs",
    "ai:key:set": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/manage-deepseek-key.ps1 -Action Set",
    "ai:key:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/manage-deepseek-key.ps1 -Action Status",
    "ai:key:delete": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/manage-deepseek-key.ps1 -Action Delete",
    "dev:tauri": "pnpm --filter @coc-room/desktop tauri dev",
    "dev:tauri:first": "pnpm prepare:windows && pnpm --filter @coc-room/desktop tauri dev",
    "build:windows": "pnpm prepare:windows && pnpm --filter @coc-room/desktop tauri build --target x86_64-pc-windows-msvc",
    "deploy:test": "pnpm --filter @coc-room/protocol build && pnpm --filter @coc-room/desktop build && pnpm --filter @coc-room/relay run deploy"
  }
}
